{
  "expo": {
    "name": "Atelier",
    "slug": "virtual-closet-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#18181B"
    },
    "android": {
      "package": "com.atelier.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#18181B"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#18181B"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Atelier needs access to your photos to upload garment images.",
          "cameraPermission": "Atelier needs access to your camera to take garment photos."
        }
      ]
    ]
  }
}