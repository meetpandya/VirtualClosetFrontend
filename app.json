{
  "expo": {
    "name": "Atelier",
    "slug": "Atelier",
    "owner": "meetpandyas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#18181B"
    },
    "android": {
      "package": "com.atelier.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#18181B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Atelier needs access to your photos to upload garment images.",
          "cameraPermission": "Atelier needs access to your camera to take garment photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e1b121e-7a18-43dc-9c8f-c5b6b0b4184a"
      }
    }
  }
}